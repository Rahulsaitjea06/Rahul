def get_db():
    conn = sqlite3.connect(DB_PATH)
    conn.row_factory = sqlite3.Row
    return conn


def normalize_text(value):
    if not value:
        return ""
    value = value.lower()
    value = value.replace("&", " and ")
    value = re.sub(r"[^a-z0-9+/\-\s]", " ", value)
    value = re.sub(r"\s+", " ", value).strip()
    return value


def parse_keywords(text):
    normalized = normalize_text(text)
    matches = []
    for skill in sorted(SKILL_KEYWORDS, key=len, reverse=True):
        if skill in normalized:
            matches.append(skill)
    return sorted(set(matches))


def extract_text_from_pdf(path):
    if PdfReader is None:
        return ""
    reader = PdfReader(str(path))
    chunks = []
    for page in reader.pages:
        text = page.extract_text() or ""
        chunks.append(text)
    return "\n".join(chunks)


def extract_text_from_docx(path):
    if DocxDocument is None:
        return ""
    doc = DocxDocument(str(path))
    paragraphs = [p.text for p in doc.paragraphs if p.text.strip()]
    return "\n".join(paragraphs)


def extract_resume_text(file_path):
    ext = Path(file_path).suffix.lower()
    if ext == ".pdf":
        return extract_text_from_pdf(file_path)
    if ext == ".docx":
        return extract_text_from_docx(file_path)
    try:
        return Path(file_path).read_text(encoding="utf-8", errors="ignore")
    except Exception:
        return ""


def parse_resume_text(text):
    text = text or ""
    profile = {
        "full_name": "",
        "email": "",
        "phone": "",
        "location": "",
        "title": "",
        "summary": text[:1200],
        "experience": "",
        "education": "",
        "projects": "",
        "skills": ", ".join(parse_keywords(text)[:15]),
    }

    for pattern_key, label in [
        (r"[A-Z][a-z]+(?:\s+[A-Z][a-z]+)+", "full_name"),
        (r"[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}", "email"),
        (r"\+?[0-9()\-\s]{7,}", "phone"),
    ]:
        match = re.search(pattern_key, text)
        if match and label in profile and not profile[label]:
            profile[label] = match.group(0).strip()

    if not profile["title"]:
        profile["title"] = "Professional"

    return profile


